<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Deve corrispondere al framework usato dall'API -->
    <TargetFramework>net8.0</TargetFramework>
    
    <!-- Abilita i controlli severi sui Nullable  -->
    <Nullable>enable</Nullable>
    
    <!-- Abilita le nuove funzionalità del compilatore C# 12 -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <!-- Impedisce che -p:Version sovrascriva questa versione -->
    <IsVersionable>false</IsVersionable>
  </PropertyGroup>

</Project>